# Modal.com Account Authentication Credentials
# Retrieve these from your ~/.modal.toml file or by running 'modal token new'
MODAL_TOKEN_ID=ak-YOUR_TOKEN_ID_HERE
MODAL_TOKEN_SECRET=as-YOUR_TOKEN_SECRET_HERE

# Teleprompter Modal Cloud Web Endpoint URL
# Set this to the URL printed after running 'modal deploy transcribe_api.py'
MODAL_URL=https://username--teleprompter-asr-transcriber-fastapi-app.modal.run
